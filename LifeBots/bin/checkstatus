#!/usr/bin/env bash
#
# checkstatus - get status of a LifeBot bot
#
# Usage: checkstatus [-n name]

# Default bot
DEF_BOT="Easy"
# All bots
ALL_BOTS="Angel Anya Easy"

export PATH="/usr/local/bin:${PATH}"
[ -d /opt/homebrew/bin ] && {
  export PATH="/opt/homebrew/bin:${PATH}"
}

have_lb=$(type -p lifebot)
[ "${have_lb}" ] || {
  echo "ERROR: cannot locate lifebot in PATH"
  exit 1
}

have_jq=$(type -p jq)
[ "${have_jq}" ] || {
  echo "ERROR: cannot locate jq in PATH"
  exit 1
}

usage() {
  printf "\nUsage: checkstatus [-A] [-n name]\n\n"
  printf "\nWhere:"
  printf "\n\t-A indicates check status of all bots [All Bots: ${ALL_BOTS}]"
  printf "\n\t-n name specifies the BOT name [default: ${DEF_BOT}]\n\n"
  exit 1
}

BOT=
allbots=
while getopts ":An:h" flag; do
  case $flag in
    A)
      allbots=1
      ;;
    n)
      BOT="$OPTARG"
      ;;
    h)
      usage
      ;;
    \?)
      echo "Invalid option: $flag"
      usage
      ;;
  esac
done
shift $(( OPTIND - 1 ))

[ "${BOT}" ] || BOT="${DEF_BOT}"

if [ "${allbots}" ]; then
  for bot in ${ALL_BOTS}
  do
    lifebot -a status -n ${bot}
    sleep 2
  done
else
  lifebot -a status -n ${BOT}
fi
