#!/usr/bin/env bash

export PATH="/usr/local/bin:${PATH}"
[ -d /opt/homebrew/bin ] && {
  export PATH="/opt/homebrew/bin:${PATH}"
}

have_lb=$(type -p lifebot)
[ "${have_lb}" ] || {
  echo "ERROR: cannot locate lifebot in PATH"
  exit 1
}

# Run with -l argument to control Easy Islay as a LifeBots Bot
# Default operation is to treat her like a Corrade bot
if [ "$1" == "-l" ]; then
  have_jq=$(type -p jq)
  [ "${have_jq}" ] || {
    echo "ERROR: cannot locate jq in PATH"
    exit 1
  }

  # Check if Bot is online and if not, login
  lifebot -a status -n Angel | jq -r '.status' | grep -i online >/dev/null || {
    lifebot -a login -n Angel -l beach
    sleep 10
  }

  lifebot -a stand -n Angel >/dev/null 2>&1
  lifebot -a teleport -n Angel -l beach >/dev/null 2>&1
  sleep 5
  lifebot -a sit -n Angel -u lifeguard
else
  # Check if online
  lifebot -a status -c Easy | grep 'Angelus Portal' >/dev/null || {
    # Maybe Easy is not online
    lifebot -a status -c Angel | grep 'Angelus Portal' >/dev/null || {
      echo "Angelus Portal does not appear to be online"
      exit 1
    }
  }

  lifebot -a stand -c Angel >/dev/null 2>&1
  lifebot -a teleport -c Angel -l beach >/dev/null 2>&1
  sleep 5
  lifebot -a sit -c Angel -u lifeguard
fi
