#!/usr/bin/env bash
#
# bots2clubdance - send the bots to the club and dance
#                  without arguments send all bots
#                  arguments can specify which bots

# Aliases for the bots that are going to dance
CBOTS="Angel Easy"
LBOTS="Anya"
# Set to region where your bots need to be
REGION="Scylla"
# Set to object UUID to touch or sit for bots to dance
UUID="cmover"
# Set to action, sit or touch object to dance
ACTION="touch_prim"
# Set to location, a Slurl or a Slurl alias
LOC="club"

export PATH="/usr/local/bin:${PATH}"
[ -d /opt/homebrew/bin ] && {
  export PATH="/opt/homebrew/bin:${PATH}"
}

have_lb=$(type -p lifebot)
[ "${have_lb}" ] || {
  echo "ERROR: cannot locate lifebot in PATH"
  exit 1
}

have_jq=$(type -p jq)
[ "${have_jq}" ] || {
  echo "ERROR: cannot locate jq in PATH"
  exit 1
}

# Check if Bots are online and if not, login
needsleep=
for bot in ${LBOTS}
do
  lifebot -a status -n ${bot} | jq -r '.status' | grep -i online >/dev/null || {
    lifebot -a login -n ${bot} -l "${LOC}"
    needsleep=1
  }
done
[ "${needsleep}" ] && sleep 20

# Send all Bots to the dance floor and dance
needsleep=
for bot in ${LBOTS}
do
  lifebot -a stand -n ${bot} >/dev/null 2>&1
  lifebot -a status -n ${bot} | jq -r '.location' | grep "${REGION}" >/dev/null || {
    lifebot -a teleport -n ${bot} -l "${LOC}"
    needsleep=1
  }
done
[ "${needsleep}" ] && sleep 10

# Sit or Touch the object to dance
for bot in ${LBOTS}
do
  lifebot -a ${ACTION} -n ${bot} -u ${UUID}
done

for bot in ${CBOTS}
do
  # Check if online
  if [ "${bot}" == "Angel" ]; then
    use="Easy"
  else
    use="Angel"
  fi
  lifebot -a status -c ${use} | grep ${bot} >/dev/null || {
    lifebot -a status -c ${bot} | grep ${bot} >/dev/null || {
      echo "${bot} does not appear to be online"
      continue
    }
  }

  lifebot -a stand -c ${bot} >/dev/null 2>&1
  sleep 1
  lifebot -a teleport -c ${bot} -l "${LOC}" >/dev/null 2>&1
  sleep 5
  lifebot -a ${ACTION} -c ${bot} -u ${UUID}
done
