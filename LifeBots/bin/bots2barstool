#!/usr/bin/env bash

export PATH="/usr/local/bin:${PATH}"
[ -d /opt/homebrew/bin ] && {
  export PATH="/opt/homebrew/bin:${PATH}"
}

have_lb=$(type -p lifebot)
[ "${have_lb}" ] || {
  echo "ERROR: cannot locate lifebot in PATH"
  exit 1
}

have_jq=$(type -p jq)
[ "${have_jq}" ] || {
  echo "ERROR: cannot locate jq in PATH"
  exit 1
}

# Check if Bots are online and if not, login
needsleep=
#for bot in Angel Anya Easy
for bot in Anya
do
  lifebot -a stand -n ${bot} >/dev/null 2>&1
  lifebot -a status -n ${bot} | jq -r '.status' | grep -i online >/dev/null || {
    lifebot -a login -n ${bot} -l beach
    needsleep=1
  }
done
[ "${needsleep}" ] && sleep 20

#for bot in Anya Easy Angel
for bot in Anya
do
  lifebot -a stand -n ${bot} >/dev/null 2>&1
  sleep 1
  lifebot -a teleport -n ${bot} -l beach >/dev/null 2>&1
  sleep 5
  lifebot -a sit -n ${bot} -u slstool
done
